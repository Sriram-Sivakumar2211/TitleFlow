# Digital Title & Escrow Closing Infrastructure Environment Configuration

PROJECT_NAME="Digital Title & Escrow Infrastructure"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security & Authentication
# Generate a secure random key with: openssl rand -hex 32
SECRET_KEY="development_secret_key_change_in_production_title_escrow_jwt_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default to SQLite for zero-setup local development; switch to PostgreSQL in production
DATABASE_URL="sqlite:///./title_escrow.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/title_escrow_db"

# Storage Configuration
STORAGE_BACKEND="local"
STORAGE_LOCAL_DIR="./storage/documents"
STORAGE_MAX_FILE_SIZE_MB=25

# AI Engine Configuration
# Providers: "fallback" (deterministic/regex - no API key needed), "openai", "gemini"
AI_PROVIDER="fallback"
AI_API_KEY=""
AI_MODEL_NAME="gemini-1.5-pro"
AI_OCR_ENABLED=True

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
